# --- Makefile.config ---
#
# Shared build rules for the RTEMS port. A benchmark Makefile sets TARGET and
# OBJS, plus the RTEMS_* variables below, and then includes this file.
#
#   RTEMS_ARGV        argv passed to main(); "@P@" becomes the processor count
#   RTEMS_STDIN       file (in the rootfs) used as stdin; may contain "@P@"
#   ROOTFS_FILES      files packed into the embedded tar image
#   INPUT_TEMPLATE    input file for P=1; input.p<N> is generated for each N
#   INPUT_SED         sed script setting the processor count, $(1) is N
#   RTEMS_POW2_ONLY   set when the benchmark needs a power-of-two count
#   RTEMS_INIT_STACK  stack size of the init thread
#   LIBS              extra archives to link
#   CLEAN_HOOKS       extra targets run by `make clean`
#   INSTALL_NAME      file name used by `make install` (default: TARGET)

BASEDIR := $(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))

# ----------------------------------------------------------------------------
# 1. Toolchain and BSP (all can be overridden on the command line)
# ----------------------------------------------------------------------------
RTEMS_TOOL_PREFIX   ?= riscv-rtems6-
BSP_PKG_CONFIG_PATH ?= /work/bsps/rv64imafdc-smp/lib/pkgconfig
RTEMS_PKG           ?= riscv-rtems6-rv64imafdc

CC = $(RTEMS_TOOL_PREFIX)gcc
AR = $(RTEMS_TOOL_PREFIX)ar
M4 = m4 -Ulen -Uindex

ifndef RTEMS_CFLAGS
RTEMS_CFLAGS := $(shell PKG_CONFIG_PATH=$(BSP_PKG_CONFIG_PATH) pkg-config --cflags $(RTEMS_PKG))
endif
ifndef RTEMS_LDFLAGS
RTEMS_LDFLAGS := $(shell PKG_CONFIG_PATH=$(BSP_PKG_CONFIG_PATH) pkg-config --libs $(RTEMS_PKG))
endif

# Some benchmarks violate strict aliasing (see upstream commit b080d8c)
CFLAGS  += $(RTEMS_CFLAGS) -O2 -std=gnu11 -fno-strict-aliasing
LDFLAGS += $(RTEMS_LDFLAGS)

# ----------------------------------------------------------------------------
# 2. Processor count
#
# Arrays are sized for SPLASH_MAX_PROCS; the count actually used is the
# number of processors online at boot, so one binary runs on 1..max cores.
# ----------------------------------------------------------------------------
SPLASH_MAX_PROCS ?= 8

ifeq ($(shell test "$(SPLASH_MAX_PROCS)" -ge 1 2>/dev/null && echo ok),)
$(error SPLASH_MAX_PROCS must be a positive integer (got '$(SPLASH_MAX_PROCS)'))
endif

CFLAGS += -DSPLASH_MAX_PROCS=$(SPLASH_MAX_PROCS)

PROC_COUNTS := $(shell seq 1 $(SPLASH_MAX_PROCS))

ifdef INPUT_TEMPLATE
INPUT_FILES := $(foreach p,$(PROC_COUNTS),input.p$(p))
endif

ifdef RTEMS_ARGV
OBJS := posix_init.o $(if $(ROOTFS_FILES),rootfs.o) $(OBJS)
endif

# ----------------------------------------------------------------------------
# 3. Global build rules
# ----------------------------------------------------------------------------
.PHONY: all clean install FORCE

all: $(TARGET)

# Link rule (helper archives such as radiosity's glib provide their own)
ifdef RTEMS_ARGV
$(TARGET): $(OBJS) $(LIBS) $(EXTRADEPS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LIBS) $(LDFLAGS) -lm
endif

# Standard C compilation
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# M4 macro expansion rules
%.h: %.h.in
	$(M4) $(BASEDIR)/pthread_macros/pthread.m4.stougie $< > $@

%.c: %.c.in
	$(M4) $(BASEDIR)/pthread_macros/pthread.m4.stougie $< > $@

# Rebuild everything when SPLASH_MAX_PROCS changes
.max_procs: FORCE
	@echo $(SPLASH_MAX_PROCS) | cmp -s - $@ || echo $(SPLASH_MAX_PROCS) > $@

$(OBJS): .max_procs

# RTEMS glue: shared POSIX_Init and embedded rootfs
rtems_args.h: Makefile $(BASEDIR)/Makefile.config
	@{ printf '#define BENCH_ARGV'; \
	   for a in $(RTEMS_ARGV); do printf ' "%s",' "$$a"; done; echo; \
	   $(if $(RTEMS_STDIN),echo '#define BENCH_STDIN "$(RTEMS_STDIN)"';) \
	   $(if $(ROOTFS_FILES),echo '#define BENCH_ROOTFS 1';) \
	   $(if $(RTEMS_POW2_ONLY),echo '#define BENCH_POW2_ONLY 1';) \
	   $(if $(RTEMS_INIT_STACK),echo '#define BENCH_INIT_STACK_SIZE ($(RTEMS_INIT_STACK))';) \
	 } > $@

posix_init.o: $(BASEDIR)/rtems/posix_init.c rtems_args.h
	$(CC) $(CFLAGS) -I. -c $< -o $@

input.p%: $(INPUT_TEMPLATE)
	sed '$(call INPUT_SED,$*)' $< > $@

rootfs.tar: $(ROOTFS_FILES) .max_procs
	tar -cf $@ -b 1 $(ROOTFS_FILES)

rootfs.o: $(BASEDIR)/rtems/rootfs.S rootfs.tar
	$(CC) $(CFLAGS) -Wa,-I. -c $< -o $@

# Install
INSTALL_NAME ?= $(TARGET)

install: $(TARGET)
	@test -n "$(BINDIR)" || { echo "install: BINDIR is not set" >&2; exit 1; }
	mkdir -p $(BINDIR)
	cp $(TARGET) $(BINDIR)/$(INSTALL_NAME)

# Collect M4-generated files
M4_GEN_C := $(patsubst %.c.in,%.c,$(wildcard *.c.in))
M4_GEN_H := $(patsubst %.h.in,%.h,$(wildcard *.h.in))

# Clean rule
clean: $(CLEAN_HOOKS)
	rm -f *.o $(TARGET) core rootfs.tar rtems_args.h input.p* .max_procs $(M4_GEN_C) $(M4_GEN_H)
