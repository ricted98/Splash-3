# --- Makefile.config ---

# 1. Define the Path Variable
BSP_PKG_CONFIG_PATH := /work/bsps/rv64imafdc-smp/lib/pkgconfig

# 2. Define the Target Package Name
RTEMS_PKG = riscv-rtems6-rv64imafdc

# 3. Define Compiler and Tools
CC      = riscv-rtems6-gcc
OBJCOPY = riscv-rtems6-objcopy
LD      = riscv-rtems6-ld
AR      = riscv-rtems6-ar
M4      = m4

# 4. Extract Flags from pkg-config
# We prepend PKG_CONFIG_PATH=... directly to the shell command to ensure it's seen.
CFLAGS  += $(shell PKG_CONFIG_PATH=$(BSP_PKG_CONFIG_PATH) pkg-config --cflags $(RTEMS_PKG))
LDFLAGS += $(shell PKG_CONFIG_PATH=$(BSP_PKG_CONFIG_PATH) pkg-config --libs $(RTEMS_PKG))

CFLAGS += -O2

NUM_PROCS ?= 2
CFLAGS += -DNUM_PROCS=$(NUM_PROCS)

BASEDIR := $(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))
MACROS  := $(BASEDIR)/pthread_macros/pthread.m4.stougie

ifndef BASEDIR
$(error Please define the BASEDIR variable)
endif

# ----------------------------------------------------------------------------
# 3. Global Build Rules
# ----------------------------------------------------------------------------
.PHONY: all clean

all: $(TARGET)

# Link Rule
$(TARGET): $(OBJS) $(EXTRADEPS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDFLAGS) -lm

# Standard C compilation
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# M4 Macro Expansion Rules
%.h: %.h.in
	$(M4) $(MACROS) $< > $@

%.c: %.c.in
	$(M4) $(MACROS) $< > $@

# Collect M4-generated files
M4_GEN_C := $(patsubst %.c.in,%.c,$(wildcard *.c.in))
M4_GEN_H := $(patsubst %.h.in,%.h,$(wildcard *.h.in))

# Clean Rule
clean:
	rm -f *.o $(TARGET) core rootfs.tar $(M4_GEN_C) $(M4_GEN_H)
